# ---------------------------------------------------------------------------
# Variáveis de ambiente opcionais do rag-ptbr-retrieval-pilot.
# Copie para `.env` e preencha apenas o necessário. NUNCA versione o `.env`.
# Credenciais nunca são impressas em logs nem gravadas em artefatos versionados.
# ---------------------------------------------------------------------------

# Raiz do projeto (opcional; por padrão usa o diretório corrente).
# RAG_PTBR_PILOT_ROOT=/caminho/para/rag-ptbr-retrieval-pilot

# Diretório de cache do Hugging Face para os checkpoints (opcional).
# Deixe vazio para usar o padrão do HF (~/.cache/huggingface).
# HF_HOME=/caminho/para/cache

# Token de acesso do Hugging Face — OBRIGATÓRIO para baixar google/embeddinggemma-300m
# (modelo com acesso restrito/gated). Gere em https://huggingface.co/settings/tokens
# e aceite os termos no model card do EmbeddingGemma.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host do Ollama para a etapa opcional de geração (Qwen3 14B).
# OLLAMA_HOST=http://127.0.0.1:11434

# Modo offline do HF (1 = proíbe qualquer download; útil para validar que nada
# baixa silenciosamente). Os testes definem isto automaticamente.
# HF_HUB_OFFLINE=0
# TRANSFORMERS_OFFLINE=0
